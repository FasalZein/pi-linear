{
  "name": "@tothemoon/pi-linear-lite",
  "version": "1.0.0",
  "description": "Linear GraphQL extension for pi with discovery-only loading, direct typed tools, and mutation safety",
  "keywords": [
    "pi-package",
    "linear",
    "graphql",
    "pi-extension"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "smoke:readonly": "node scripts/smoke-readonly.mjs",
    "capture:readonly-schema": "node scripts/capture-readonly-schema.mjs",
    "validate:readonly-schema": "node scripts/validate-readonly-schema.mjs",
    "generate": "vite-node scripts/generate-cli.ts",
    "generate:check": "vite-node scripts/generate-cli.ts --check && vite-node scripts/generate-cli.ts --allowlists-check",
    "sync:linear-agent-allowlists": "vite-node scripts/generate-cli.ts --allowlists-sync",
    "check:linear-agent-allowlists": "vite-node scripts/generate-cli.ts --allowlists-check",
    "test:schema-bytes": "vite-node scripts/schema-bytes.ts",
    "test:pi:min": "vite-node scripts/test-pi-version.ts min",
    "test:pi:current": "vite-node scripts/test-pi-version.ts current",
    "test:provider:fallback": "vitest run test/fallback-provider-route.test.ts",
    "test:provider:anthropic": "vitest run test/anthropic-provider-route.test.ts",
    "test:provider:openai": "vitest run test/openai-provider-route.test.ts",
    "test:provider:google": "vitest run test/google-schema-conversion.test.ts",
    "test:provider:proxy": "vitest run test/proxy-provider-route.test.ts",
    "test:providers": "vitest run test/fallback-provider-route.test.ts test/anthropic-provider-route.test.ts test/openai-provider-route.test.ts test/google-schema-conversion.test.ts test/proxy-provider-route.test.ts",
    "verify:package": "vite-node scripts/verify-package.ts",
    "verify:clean": "vite-node scripts/verify-clean.ts"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "scripts",
    "docs",
    "CHANGELOG.md",
    "CONTEXT.md",
    "REFERENCE.md",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.7",
    "@earendil-works/pi-coding-agent": ">=0.80.7",
    "typebox": ">=1.1.38",
    "@earendil-works/pi-tui": ">=0.80.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@oxlint/plugins": "1.80.0",
    "@vitest/coverage-istanbul": "3.2.7",
    "oxlint": "1.80.0",
    "typebox": "^1.1.38",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "graphql": "16.14.2"
  }
}
