{
  "name": "@tothemoon/pi-linear-lite",
  "version": "0.5.0",
  "description": "Linear GraphQL extension for pi with named operations, lazily loaded typed tools, and mutation safety",
  "keywords": [
    "pi-package",
    "linear",
    "graphql",
    "pi-extension"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke:readonly": "node scripts/smoke-readonly.mjs",
    "capture:readonly-schema": "node scripts/capture-readonly-schema.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "scripts",
    "docs",
    "CHANGELOG.md",
    "CONTEXT.md",
    "REFERENCE.md",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.7",
    "@earendil-works/pi-coding-agent": ">=0.80.7",
    "typebox": ">=1.1.38",
    "@earendil-works/pi-tui": ">=0.80.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "typebox": "^1.1.38",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "graphql": "16.14.2"
  }
}
